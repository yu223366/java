# ============================================================
#  雾山五行 · 前端环境变量示例
#  复制为 .env.local 使用（.env.local 不纳入 git）
# ============================================================

# 后端接口前缀（预留）。不配置时默认 /api
VITE_API_BASE_URL=/api

# 是否使用本地 mock。false = 直连真实后端
# 未接后端时保持 true，注册流程可离线完整跑通
VITE_USE_MOCK=true

# 请求超时（毫秒）
VITE_API_TIMEOUT=12000
