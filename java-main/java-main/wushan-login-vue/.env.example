# ============================================================
#  雾山五行 · 前端环境变量示例
#  复制为 .env.local 使用（.env.local 不纳入 git）
# ============================================================

# 后端接口前缀（预留）。不配置时默认 /api
VITE_API_BASE_URL=/api

# 是否使用本地 mock。false = 直连真实后端
# 当前默认即真实后端模式（登录 / 权限 role / 宝库均以 MySQL 为准）；
# 需要离线演示时改成 true（mock 下只有名号 admin 会被当成执事）
VITE_USE_MOCK=false

# 请求超时（毫秒）
VITE_API_TIMEOUT=12000
